# ==============================================================================
# DSH Studio - 环境变量示例配置 (.env.example)
# 复制此文件为 .env 并填入您自己的 API Key。
# 注意：切勿将包含真实 API Key 的 .env 文件提交到 Git 仓库！
# ==============================================================================

# 1. DeepSeek 大模型凭据配置 (或在前端设置中心配置)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 可选：自定义 DeepSeek Base URL (默认为官方接口 https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 2. 图像理解与多模态模型配置 (describe-image 插件，或在前端插件设置中配置)
# 支持任意兼容 OpenAI 视觉接口的 BaseURL / Model
# VISION_API_KEY=your_vision_api_key_here
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
